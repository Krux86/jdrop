{
  "manifest_version": 3,
  "name": "JDrop",
  "short_name": "JDrop",
  "version": "1.1.0",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "icons": {
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    },
    "default_title": "JDrop",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "send-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Send the current tab to JDownloader"
    }
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "declarativeNetRequest",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.jdownloader.org/*",
    "http://127.0.0.1:9666/*",
    "http://localhost:9666/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/cnl-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*/*"],
      "js": ["content/cnl-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*/*"],
      "js": ["content/panel-host.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html"],
      "matches": ["*://*/*"]
    }
  ]
}
